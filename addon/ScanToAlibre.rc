/////////////////////////////////////////////////////////////////////////////
// Icon

IDI_SCANTOALIBRE        ICON                    "res\\ScanToAlibre.ico"

/////////////////////////////////////////////////////////////////////////////
// Dialog

IDD_ABOUTBOX DIALOGEX 0, 0, 250, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About ScanToAlibre"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_SCANTOALIBRE,IDC_STATIC,14,14,20,20
    LTEXT           "ScanToAlibre Add-On for Alibre Design",IDC_STATIC,46,14,190,8,SS_NOPREFIX
    LTEXT           "Version",IDC_ADDON_VERSION,46,27,190,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026 Frank's Workshop",IDC_STATIC,46,40,190,8,SS_NOPREFIX
    LTEXT           "Running in Alibre Design",IDC_ALIBRE_VERSION,46,58,190,16,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,186,83,50,14,WS_GROUP
END

IDD_REFINE DIALOGEX 0, 0, 236, 262
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Refine Scan"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Scan",IDC_STATIC,7,7,222,26
    LTEXT           "",IDC_REFINE_INFO,15,18,206,8,SS_NOPREFIX | SS_ENDELLIPSIS
    GROUPBOX        "Decimate: fewer triangles",IDC_STATIC,7,38,222,88
    CONTROL         "Triangles:",IDC_DEC_BY_COUNT,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,52,80,10
    EDITTEXT        IDC_DEC_COUNT,100,50,60,14,ES_AUTOHSCROLL | WS_GROUP
    CONTROL         "Percent of now:",IDC_DEC_BY_PERCENT,"Button",BS_AUTORADIOBUTTON,15,70,80,10
    EDITTEXT        IDC_DEC_PERCENT,100,68,60,14,ES_AUTOHSCROLL
    LTEXT           "%",IDC_STATIC,164,70,10,8
    CONTROL         "Largest change (mm):",IDC_DEC_LIMIT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,88,84,10
    EDITTEXT        IDC_DEC_LIMIT_MM,100,86,60,14,ES_AUTOHSCROLL
    CONTROL         "Keep open edges",IDC_DEC_KEEP_EDGES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,107,90,10
    PUSHBUTTON      "Decimate",IDC_DEC_APPLY,171,105,50,14
    GROUPBOX        "Smooth",IDC_STATIC,7,131,222,86
    LTEXT           "Method:",IDC_STATIC,15,146,40,8
    COMBOBOX        IDC_SMOOTH_METHOD,60,144,161,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Passes:",IDC_STATIC,15,165,40,8
    EDITTEXT        IDC_SMOOTH_PASSES,60,163,40,14,ES_AUTOHSCROLL
    LTEXT           "Strength (0 to 1):",IDC_STATIC,110,165,60,8
    EDITTEXT        IDC_SMOOTH_STRENGTH,172,163,49,14,ES_AUTOHSCROLL
    CONTROL         "Keep open edges",IDC_SMOOTH_KEEP_EDGES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,184,90,10
    PUSHBUTTON      "Smooth",IDC_SMOOTH_APPLY,171,196,50,14
    LTEXT           "",IDC_REFINE_STATUS,7,222,222,16,SS_NOPREFIX
    PUSHBUTTON      "Undo",IDC_REFINE_UNDO,7,241,50,14
    PUSHBUTTON      "Close",IDCANCEL,179,241,50,14
END

IDD_ORIENT DIALOGEX 0, 0, 250, 384
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Orient Scan"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Scan",IDC_STATIC,7,7,236,26
    LTEXT           "",IDC_OR_INFO,15,18,222,8,SS_NOPREFIX | SS_ENDELLIPSIS
    GROUPBOX        "Move (mm)",IDC_STATIC,7,38,236,46
    LTEXT           "X:",IDC_STATIC,15,53,8,8
    EDITTEXT        IDC_OR_MOVE_X,25,51,45,14,ES_AUTOHSCROLL
    LTEXT           "Y:",IDC_STATIC,76,53,8,8
    EDITTEXT        IDC_OR_MOVE_Y,86,51,45,14,ES_AUTOHSCROLL
    LTEXT           "Z:",IDC_STATIC,137,53,8,8
    EDITTEXT        IDC_OR_MOVE_Z,147,51,45,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Move",IDC_OR_MOVE,197,51,40,14
    PUSHBUTTON      "Centre on the Origin",IDC_OR_CENTRE,15,67,90,14
    GROUPBOX        "Rotate",IDC_STATIC,7,89,236,46
    LTEXT           "About",IDC_STATIC,15,104,22,8
    COMBOBOX        IDC_OR_ROT_AXIS,40,102,30,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "by",IDC_STATIC,75,104,10,8
    EDITTEXT        IDC_OR_ROT_ANGLE,88,102,40,14,ES_AUTOHSCROLL
    LTEXT           "degrees",IDC_STATIC,131,104,30,8
    PUSHBUTTON      "Rotate",IDC_OR_ROTATE,197,102,40,14
    LTEXT           "through",IDC_STATIC,15,120,30,8
    COMBOBOX        IDC_OR_ROT_PIVOT,48,118,110,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Scale",IDC_STATIC,7,140,236,30
    LTEXT           "Factor:",IDC_STATIC,15,154,28,8
    EDITTEXT        IDC_OR_SCALE,46,152,40,14,ES_AUTOHSCROLL
    LTEXT           "through",IDC_STATIC,91,154,30,8
    COMBOBOX        IDC_OR_SCALE_PIVOT,122,152,70,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Scale",IDC_OR_SCALE_APPLY,197,152,40,14
    GROUPBOX        "Clicks on the scan",IDC_STATIC,7,175,236,30
    CONTROL         "Choose geometry to align",IDC_OR_MODE_PICK,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,189,110,10
    CONTROL         "Select a flat area",IDC_OR_MODE_SELECT,"Button",BS_AUTORADIOBUTTON,130,189,100,10
    GROUPBOX        "Fit a plane to the selected area",IDC_STATIC,7,210,236,48
    LTEXT           "Within",IDC_STATIC,15,224,24,8
    EDITTEXT        IDC_OR_GROW_ANGLE,42,222,30,14,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "degrees and",IDC_STATIC,76,224,44,8
    EDITTEXT        IDC_OR_GROW_DIST,121,222,30,14,ES_AUTOHSCROLL
    LTEXT           "mm",IDC_STATIC,155,224,15,8
    LTEXT           "",IDC_OR_SELECTED,15,242,125,8,SS_NOPREFIX
    PUSHBUTTON      "Clear",IDC_OR_CLEAR,145,239,40,14
    PUSHBUTTON      "Fit Plane",IDC_OR_FIT,190,239,47,14
    GROUPBOX        "Align (3-2-1)",IDC_STATIC,7,263,236,76
    LTEXT           "",IDC_OR_STEP,15,275,222,16,SS_NOPREFIX
    LTEXT           "Scan:",IDC_STATIC,15,294,25,8
    LTEXT           "",IDC_OR_SCAN_FEATURE,45,294,192,8,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "To:",IDC_STATIC,15,306,25,8
    LTEXT           "",IDC_OR_TARGET,45,306,192,8,SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL         "Flip",IDC_OR_FLIP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,320,40,10
    PUSHBUTTON      "Start Over",IDC_OR_START_OVER,143,318,47,14
    PUSHBUTTON      "Align",IDC_OR_ALIGN,195,318,42,14
    LTEXT           "",IDC_OR_STATUS,7,344,236,16,SS_NOPREFIX
    PUSHBUTTON      "Undo",IDC_OR_UNDO,7,363,50,14
    PUSHBUTTON      "Close",IDCANCEL,193,363,50,14
END

