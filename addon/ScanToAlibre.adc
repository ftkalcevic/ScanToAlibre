   <Property name="Identifier" value="{3B8754FC-F18D-4AE9-887D-E48DD9EE5DCB}"/>
   <MenuFile loadedWhen="Startup"/>
   <PersistentData streamName="ScanToAlibre_Scan" StreamName="ScanToAlibre_Scan"/>
</AlibreDesignAddOn>
